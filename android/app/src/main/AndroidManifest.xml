<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kekecsy.ygoruling">
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.deepseek.chat" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.aliyun.tongyi" />
        <package android:name="com.google.android.apps.bard" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="YGO判例助手"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
